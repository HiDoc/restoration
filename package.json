{
  "name": "pokemon-vibe-game",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "init-db": "tsx scripts/init-database.ts",
    "test-db": "tsx scripts/test-database.ts",
    "build:rust": "node scripts/build-rust.mjs",
    "predev": "npm run build:rust",
    "prebuild": "npm run build:rust",
    "pretest": "npm run build:rust",
    "pretest:watch": "npm run build:rust",
    "pretest:coverage": "npm run build:rust",
    "test:rust": "cargo test --locked --manifest-path rust/ecosim-core/Cargo.toml",
    "check:rust": "cargo fmt --manifest-path rust/ecosim-core/Cargo.toml --check && cargo clippy --locked --manifest-path rust/ecosim-core/Cargo.toml --all-targets -- -D warnings",
    "test:all": "npm run test:rust && npm test"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/sqlite3": "^3.1.11",
    "@vitejs/plugin-vue": "^6.0.1",
    "canvas": "^3.2.0",
    "pinia": "^3.0.4",
    "pixi.js": "^8.13.1",
    "sqlite3": "^5.1.7",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.35.0",
    "eslint-plugin-vue": "^10.4.0",
    "jsdom": "^27.0.0",
    "oxlint": "^1.14.0",
    "postcss": "^8.5.6",
    "postcss-import": "^16.1.1",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.6"
  }
}
